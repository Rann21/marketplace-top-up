# Environment Variables Template
# Copy file ini menjadi .env dan isi dengan credentials Anda

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Payment Gateway (untuk integrasi future)
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# Optional: Notification Services
WHATSAPP_API_KEY=
EMAIL_API_KEY=

# Notes:
# - SUPABASE_URL: Dapatkan dari Supabase Dashboard > Settings > API
# - SUPABASE_ANON_KEY: Public key yang aman untuk frontend
# - Jangan commit file .env ke git (sudah ada di .gitignore)
